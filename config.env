# Shared build configuration (sourced by scripts/*.sh).
# BUNDLE_ID must never change after the first install: macOS keys permissions on it.
# If you change BUNDLE_ID or GITHUB_REPO, update the defaults at the top of install.sh too.
APP_NAME="MacUtils"
BUNDLE_ID="io.github.llipovsky.macutils"
GITHUB_REPO="llipovsky/mac-utils"
SIGNING_IDENTITY="MacUtils Self-Signed"
MIN_MACOS="13.0"
